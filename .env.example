# ===== APPLICATION =====
NODE_ENV=development
APP_NAME=RoadSafe
APP_VERSION=1.0.0
APP_DESCRIPTION=Roadside Assistance Marketplace for East Africa
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
API_PORT=3001
WEB_PORT=3000
ADMIN_PORT=3002
PROVIDER_PORT=3003

# ===== DATABASE =====
DATABASE_URL=postgresql://roadsafe:password123@localhost:5432/roadsafe
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=roadsafe
DATABASE_USER=roadsafe
DATABASE_PASSWORD=password123
DATABASE_LOGGING=false

# ===== REDIS =====
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== AUTHENTICATION =====
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key
REFRESH_TOKEN_EXPIRATION=30d
OTP_EXPIRATION=600
OTP_LENGTH=6
OTP_ATTEMPTS=3

# ===== EMAIL =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@roadsafe.ke
MAIL_FROM_NAME=RoadSafe

# ===== SMS =====
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=ROADSAFE

# ===== STORAGE =====
STORAGE_TYPE=local
STORAGE_PATH=./uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# ===== MAPS =====
MAP_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# ===== MPESA =====
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:3001/api/v1/payments/mpesa/callback
MPESA_ENVIRONMENT=sandbox
PAYMENT_MODE=mock

# ===== WHATSAPP =====
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ===== AI =====
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-vision
ANTHROPIC_API_KEY=
LOCAL_AI_URL=

# ===== MONITORING =====
LOG_LEVEL=info
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
DATA_DOG_API_KEY=

# ===== FEATURES =====
DEMO_MODE=false
FEATURE_AI_ASSISTANT=false
FEATURE_IMAGE_ANALYSIS=false
FEATURE_SPARE_PARTS=false
FEATURE_GARAGE_BOOKINGS=false
FEATURE_MAINTENANCE_REMINDERS=false
FEATURE_FLEET_MANAGEMENT=false
FEATURE_SUBSCRIPTIONS=false
FEATURE_REFERRALS=false
FEATURE_WHATSAPP=false
FEATURE_ANALYTICS=true

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_MAX=3
PAYMENT_RATE_LIMIT_MAX=10

# ===== SECURITY =====
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:3003
SESSION_SECRET=your-session-secret-change-in-production
FILE_UPLOAD_MAX_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# ===== DISPATCH =====
DISPATCH_SEARCH_RADIUS_KM=50
DISPATCH_TIMEOUT_SECONDS=300
DISPATCH_MAX_ATTEMPTS=5
DISPATCH_SCORING_ETA_WEIGHT=0.30
DISPATCH_SCORING_DISTANCE_WEIGHT=0.20
DISPATCH_SCORING_RELIABILITY_WEIGHT=0.20
DISPATCH_SCORING_RATING_WEIGHT=0.15
DISPATCH_SCORING_PRICE_WEIGHT=0.10
DISPATCH_SCORING_ACCEPTANCE_WEIGHT=0.05

# ===== GPS =====
GPS_ACCURACY_THRESHOLD_METERS=100
LOCATION_UPDATE_INTERVAL_SECONDS=10
LOCATION_UPDATE_THROTTLE_MS=5000

# ===== DATA RETENTION =====
RETENTION_LOCATION_DAYS=30
RETENTION_MESSAGES_DAYS=90
RETENTION_AUDIT_LOGS_DAYS=365
RETENTION_JOB_PHOTOS_DAYS=180

# ===== PRICING =====
PLATFORM_COMMISSION_PERCENTAGE=15
MINIMUM_SERVICE_FEE=100
CURRENCY=KES

# ===== ADMIN =====
ADMIN_EMAIL=admin@roadsafe.ke
ADMIN_DEFAULT_PASSWORD=Change@123
